@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix bao:     <http://www.bioassayontology.org/bao#> .
@prefix sio:     <http://semanticscience.org/resource/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix makaao:  <http://makaao.inria.fr/kg/> .

######################################################################
# Generic label integrity
######################################################################

makaao:NoBlankLabelsShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdfs:label, skos:prefLabel ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Labels and preferred labels must not be empty or whitespace-only." ;
        sh:select """
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?label
            WHERE {
              { $this rdfs:label ?label }
              UNION
              { $this skos:prefLabel ?label }
              FILTER(!isLiteral(?label) || STRLEN(REPLACE(STR(?label), "^\\\\s+|\\\\s+$", "")) = 0)
            }
        """ ;
    ] .

######################################################################
# Reified relations retained in the canonical KG
######################################################################

makaao:RelationShape
    a sh:NodeShape ;
    sh:targetClass makaao:Relation ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue rdf:Statement ;
        sh:message "Every makaao:Relation must also be an rdf:Statement." ;
    ] ;
    sh:property [
        sh:path rdf:subject ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path rdf:predicate ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path rdf:object ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:class makaao:Document ;
        sh:severity sh:Warning ;
        sh:message "A reified Relation should cite at least one makaao:Document." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ordinary triple represented by this Relation is missing." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this ?s ?p ?o
            WHERE {
              $this rdf:subject ?s ; rdf:predicate ?p ; rdf:object ?o .
              FILTER NOT EXISTS { ?s ?p ?o }
            }
        """ ;
    ] .

######################################################################
# Documents
######################################################################

makaao:DocumentShape
    a sh:NodeShape ;
    sh:targetClass makaao:Document ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path rdfs:seeAlso ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Every Document must identify its external source with rdfs:seeAlso." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A Document other than the core CSV metadata document should be cited by a Relation." ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this
            WHERE {
              FILTER($this != <http://makaao.inria.fr/kg/makaao_core.csv>)
              FILTER NOT EXISTS { ?relation prov:wasDerivedFrom $this }
            }
        """ ;
    ] .

######################################################################
# Local UMLS resources introduced by script 03
######################################################################

makaao:LocalUMLSLabelShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this
            WHERE {
              { ?this ?p ?o } UNION { ?s ?p ?this }
              FILTER(STRSTARTS(STR(?this), "http://makaao.inria.fr/kg/CUI_C"))
            }
        """ ;
    ] ;
    sh:nodeKind sh:IRI ;
    sh:or (
        [ sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ]
        [ sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] ]
    ) ;
    sh:message "Every generated local UMLS class or instance must have a label." .

######################################################################
# Symmetric and inverse relationships produced by script 03
######################################################################

makaao:CloseMatchSymmetryShape
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:closeMatch ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every skos:closeMatch assertion must have its reverse assertion." ;
        sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?other
            WHERE {
              $this skos:closeMatch ?other .
              FILTER NOT EXISTS { ?other skos:closeMatch $this }
            }
        """ ;
    ] .

makaao:SIOAssociationSymmetryShape
    a sh:NodeShape ;
    sh:targetSubjectsOf sio:SIO_001403 ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "SIO_001403 associations must be asserted in both directions." ;
        sh:select """
            PREFIX sio: <http://semanticscience.org/resource/>
            SELECT $this ?other
            WHERE {
              $this sio:SIO_001403 ?other .
              FILTER NOT EXISTS { ?other sio:SIO_001403 $this }
            }
        """ ;
    ] .

makaao:PhenotypeInverseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf sio:SIO_001279 ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "SIO_001279 must have the corresponding inverse SIO_001280 assertion." ;
        sh:select """
            PREFIX sio: <http://semanticscience.org/resource/>
            SELECT $this ?phenotype
            WHERE {
              $this sio:SIO_001279 ?phenotype .
              FILTER NOT EXISTS { ?phenotype sio:SIO_001280 $this }
            }
        """ ;
    ] .

makaao:PhenotypeReverseInverseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf sio:SIO_001280 ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "SIO_001280 must have the corresponding inverse SIO_001279 assertion." ;
        sh:select """
            PREFIX sio: <http://semanticscience.org/resource/>
            SELECT $this ?entity
            WHERE {
              $this sio:SIO_001280 ?entity .
              FILTER NOT EXISTS { ?entity sio:SIO_001279 $this }
            }
        """ ;
    ] .

makaao:BAOTargetInverseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bao:BAO_0000211 ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "BAO_0000211 must have the corresponding BAO_0000598 inverse assertion." ;
        sh:select """
            PREFIX bao: <http://www.bioassayontology.org/bao#>
            SELECT $this ?target
            WHERE {
              $this bao:BAO_0000211 ?target .
              FILTER NOT EXISTS { ?target bao:BAO_0000598 $this }
            }
        """ ;
    ] .

makaao:BAOTargetReverseInverseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bao:BAO_0000598 ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "BAO_0000598 must have the corresponding BAO_0000211 inverse assertion." ;
        sh:select """
            PREFIX bao: <http://www.bioassayontology.org/bao#>
            SELECT $this ?aab
            WHERE {
              $this bao:BAO_0000598 ?aab .
              FILTER NOT EXISTS { ?aab bao:BAO_0000211 $this }
            }
        """ ;
    ] .

makaao:BiomarkerInverseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf biolink:biomarker_for ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "biolink:biomarker_for must have the corresponding biolink:has_biomarker inverse assertion." ;
        sh:select """
            PREFIX biolink: <https://w3id.org/biolink/vocab/>
            SELECT $this ?phenotype
            WHERE {
              $this biolink:biomarker_for ?phenotype .
              FILTER NOT EXISTS { ?phenotype biolink:has_biomarker $this }
            }
        """ ;
    ] .

makaao:BiomarkerReverseInverseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf biolink:has_biomarker ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "biolink:has_biomarker must have the corresponding biolink:biomarker_for inverse assertion." ;
        sh:select """
            PREFIX biolink: <https://w3id.org/biolink/vocab/>
            SELECT $this ?autoantibody
            WHERE {
              $this biolink:has_biomarker ?autoantibody .
              FILTER NOT EXISTS { ?autoantibody biolink:biomarker_for $this }
            }
        """ ;
    ] .

######################################################################
# Domain-resource integrity
######################################################################

makaao:TargetShape
    a sh:NodeShape ;
    sh:targetClass makaao:Target ;
    sh:property [
        sh:path bao:BAO_0000598 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:qualifiedValueShape [
            sh:class makaao:Autoantibody ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each Target instance must be the target of at least one autoantibody." ;
    ] .

makaao:AutoimmunityRelatedDiseaseShape
    a sh:NodeShape ;
    sh:targetClass makaao:AutoimmunityRelatedDisease ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "An autoimmunity-related-disease instance should have a local rdfs:label when available." ;
    ] ;
    sh:property [
        sh:path sio:SIO_001403 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:qualifiedValueShape [
            sh:class makaao:Autoantibody ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each autoimmunity-related-disease instance must have an SIO_001403 association to at least one autoantibody instance." ;
    ] .

makaao:AutoantibodyBiomarkerShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX makaao: <http://makaao.inria.fr/kg/>
            SELECT ?this
            WHERE {
              ?this rdf:type ?type .
              ?type rdfs:subClassOf* makaao:Autoantibody .
            }
        """ ;
    ] ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path biolink:biomarker_for ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:qualifiedValueShape [
            sh:class biolink:PhenotypicFeature ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each autoantibody instance must be linked by biolink:biomarker_for to at least one phenotypic-feature instance." ;
    ] .

makaao:PositivityHasBiomarkerShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX makaao: <http://makaao.inria.fr/kg/>
            SELECT ?this
            WHERE {
              ?this rdf:type ?type .
              ?type rdfs:subClassOf* makaao:AutoantibodyPositivity .
            }
        """ ;
    ] ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path biolink:has_biomarker ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:qualifiedValueShape [
            sh:class makaao:Autoantibody ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each local positivity instance must be linked by biolink:has_biomarker to at least one autoantibody instance." ;
    ] .